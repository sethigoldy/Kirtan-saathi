{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist/renderer-build",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/renderer/**/*.ts"]
}
