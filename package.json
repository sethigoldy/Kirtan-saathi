{
  "name": "kirtan-saathi",
  "productName": "Kirtan Saathi",
  "version": "0.1.0",
  "description": "Kirtan Saathi: offline live Gurbani shabad detection and line following for kirtan, paath and banis",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "build-corpus": "node dist/cli/build-corpus.js",
    "start": "npm run build && electron .",
    "run-file": "node dist/cli/run-file.js",
    "bench": "node dist/cli/bench.js",
    "score": "node dist/cli/score.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "calibrate": "node dist/cli/calibrate.js",
    "paath-eval": "node dist/cli/paath-eval.js",
    "ci-bench": "node dist/cli/ci-bench.js",
    "soak": "node dist/cli/soak.js",
    "dist": "npm run build && electron-builder --publish never",
    "icon": "python3 scripts/make-icon.py",
    "darbar-batch": "node dist/cli/darbar-batch.js"
  },
  "dependencies": {
    "onnxruntime-node": "1.23.2"
  },
  "devDependencies": {
    "@fontsource-variable/anek-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@types/node": "^22.0.0",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.0"
  },
  "author": {
    "name": "Kirtan Saathi contributors",
    "email": "sethigoldy@users.noreply.github.com"
  },
  "homepage": "https://github.com/sethigoldy/Kirtan-saathi",
  "repository": {
    "type": "git",
    "url": "https://github.com/sethigoldy/Kirtan-saathi.git"
  }
}
